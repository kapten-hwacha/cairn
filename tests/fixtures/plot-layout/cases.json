      "id": "04-multiple",
      "input": {
        "xLabel": "x (radians)",
        "xScale": "linear",
        "xDomain": [0, 6.2832],
        "panels": [
          {
            "title": "$\\sin x$ and $\\cos x$ on $[0, 2\\pi]$",
            "yLabel": "amplitude",
            "yScale": "linear",
            "yDomain": [-1.2, 1.2],
            "curves": [
              {
                "label": "$\\sin x$",
                "expression": "sin(x)"
              },
              {
                "label": "$\\cos x$",
                "expression": "cos(x)"
              }
            ],
            "annotations": [
              {
                "x": 1.5708,
                "y": 1,
                "label": "$x=\\pi/2$: $\\sin=1,\\ \\cos=0$"
              },
              {
                "x": 3.1416,
                "y": -1,
                "label": "$x=\\pi$: $\\cos=-1$"
              },
              {
                "x": 4.7124,
                "y": -1,
                "label": "$x=3\\pi/2$: $\\sin=-1$"
              },
              {
                "x": 0.7854,
                "y": 0.7071,
                "label": "$x=\\pi/4$: equal"
              }
            ]
          }
        ]
      }
    },
