    {
      "id": "07-bode",
      "input": {
        "xLabel": "Frequency $f$ (Hz)",
        "xScale": "log",
        "xDomain": [10, 100000],
        "panels": [
          {
            "title": "Magnitude of $H(jf)$ — single pole at 1 kHz",
            "yLabel": "20 log₁₀|H| (dB)",
            "yScale": "linear",
            "yDomain": [-45, 5],
            "curves": [
              {
                "label": "$|H|$ in dB",
                "expression": "-10*log10(1+(x/1000)^2)"
              }
            ],
            "annotations": [
              {
                "x": 1000,
                "y": -3.01,
                "label": "−3 dB at 1 kHz"
              },
              {
                "x": 100000,
                "y": -40,
                "label": "−40 dB (−20 dB/decade)"
              }
            ]
          },
          {
            "title": "Phase of $H(jf)$",
            "yLabel": "phase (degrees)",
            "yScale": "linear",
            "yDomain": [-95, 5],
            "curves": [
              {
                "label": "$\\arg H$ in degrees",
                "expression": "-atan(x/1000)*180/pi"
              }
            ],
            "annotations": [
              {
                "x": 1000,
                "y": -45,
                "label": "−45° at 1 kHz"
              },
              {
                "x": 100000,
                "y": -89.4,
                "label": "→ −90°"
              }
            ]
          }
        ]
      }
    },
